{
  "name": "@weaverse/naturelle",
  "version": "3.0.0",
  "description": "A beauty-focused Shopify storefront built with Hydrogen and Weaverse",
  "keywords": [
    "shopify",
    "hydrogen",
    "theme",
    "hydrogen-theme",
    "weaverse",
    "ecommerce",
    "react",
    "react-router",
    "typescript",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Weaverse",
  "type": "module",
  "homepage": "https://naturelle.weaverse.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weaverse/naturelle.git"
  },
  "bugs": {
    "url": "https://github.com/weaverse/naturelle/issues"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-node22-runtime.mjs",
    "prebuild": "node scripts/prepare-node22-runtime.mjs",
    "build": "shopify hydrogen build --codegen",
    "predev": "node scripts/prepare-node22-runtime.mjs",
    "dev": "react-router typegen && shopify hydrogen dev --codegen --port 3456",
    "predev:ca": "node scripts/prepare-node22-runtime.mjs",
    "dev:ca": "shopify hydrogen dev --codegen --port 3456 --customer-account-push",
    "prepreview": "node scripts/prepare-node22-runtime.mjs",
    "preview": "shopify hydrogen preview --build",
    "prestart": "node scripts/prepare-node22-runtime.mjs",
    "start": "shopify hydrogen preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "preroutes-check": "node scripts/prepare-node22-runtime.mjs",
    "routes-check": "shopify hydrogen check routes",
    "precodegen": "node scripts/prepare-node22-runtime.mjs",
    "codegen": "shopify hydrogen codegen",
    "prehydrogen": "node scripts/prepare-node22-runtime.mjs",
    "hydrogen": "shopify hydrogen",
    "clean": "rm -rf dist node_modules .shopify .react-router",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "biome": "biome check",
    "biome:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "i18n:check": "node scripts/check-translations.mjs",
    "locale:check": "node scripts/run-unit-tests.mjs tests/locale.unit.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/belleza": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@graphql-codegen/cli": "7.4.6",
    "@headlessui/react": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-menubar": "^1.1.10",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/hydrogen": "~2026.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@weaverse/hydrogen": "^5.20.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "framer-motion": "12.23.24",
    "graphql": "16.14.2",
    "isbot": "^5.2.1",
    "lucide-react": "^0.501.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "11.0.0",
    "react-player": "^3.4.0",
    "react-router": "7.16.0",
    "react-use": "17.6.1",
    "schema-dts": "2.0.0",
    "swiper": "^14.1.0",
    "tailwind-merge": "3.6.0",
    "tar": "7.5.22",
    "tiny-invariant": "1.3.3",
    "typographic-base": "1.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "1.62.1",
    "@shopify/cli": "4.6.1",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "file:vendor/mini-oxygen",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@weaverse/biome": "5.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@whatwg-node/disposablestack": "0.0.6",
    "@whatwg-node/fetch": "0.10.13",
    "@whatwg-node/promise-helpers": "1.3.2",
    "@shopify/mini-oxygen": {
      "body-parser": {
        ".": "1.20.9",
        "qs": "6.16.1"
      },
      "miniflare": {
        "undici": "6.29.1",
        "youch": {
          "cookie": "0.7.2"
        }
      },
      "undici": "7.30.1"
    },
    "@fastify/busboy": "3.2.2",
    "js-yaml": "4.3.2",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "rolldown": "1.2.4",
    "postcss-selector-parser": "7.1.7",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "sync-fetch": "0.6.0",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  }
}
